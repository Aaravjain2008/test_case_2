# ============================================================
#  RAG System — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Supported: "ollama"  (local, no API key needed)
LLM_PROVIDER=ollama

# Ollama model to use (must be pulled first: `ollama pull llama3.2`)
OLLAMA_MODEL=llama3.2

# Ollama server base URL (default when running locally)
OLLAMA_BASE_URL=http://localhost:11434

# ── Embedding Model ───────────────────────────────────────────
# Local sentence-transformers model — no API key needed.
# Options: all-MiniLM-L6-v2 (fast/small), all-mpnet-base-v2 (slower/better)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ──────────────────────────────────────────────────
# Folder where the vector store is persisted on disk
CHROMA_PERSIST_DIR=./chroma_db

# Name of the ChromaDB collection
CHROMA_COLLECTION=rag_knowledge_base

# ── Data ──────────────────────────────────────────────────────
# Directory containing documents to ingest
DATA_DIR=./data

# ── Retrieval ─────────────────────────────────────────────────
# Number of top chunks to retrieve for each query
TOP_K=5

# Maximum L2 distance to accept a chunk as relevant.
# Chunks with distance > RELEVANCE_THRESHOLD are filtered out.
# Lower = stricter.  Typical range for MiniLM: 0.8 (tight) – 1.5 (loose)
RELEVANCE_THRESHOLD=1.2

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Logging ──────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
